{
  "name": "opencode-protocol-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenCode Zen/Go protocol bridge with a local management console",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "install:sing-box": "node scripts/install-sing-box.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:signatures": "npm audit signatures",
    "sbom:prod": "npm sbom --omit=dev --sbom-format=cyclonedx",
    "test:live:go": "node scripts/live-go-smoke.mjs",
    "check:go-catalog": "node scripts/check-go-catalog.mjs",
    "check:zen-catalog": "node scripts/check-zen-catalog.mjs",
    "check:catalogs": "npm run check:go-catalog && npm run check:zen-catalog",
    "test:cli:codex": "node scripts/probe-cli-compat.mjs --codex-only",
    "test:cli:installed": "node scripts/probe-cli-compat.mjs",
    "rekey": "node scripts/rekey.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80",
    "check": "node scripts/check-syntax.mjs && node --test"
  },
  "engines": {
    "node": "^22.20.0 || ^24.11.0"
  },
  "dependencies": {
    "fetch-socks": "^1.3.3",
    "undici": "^8.10.0"
  }
}

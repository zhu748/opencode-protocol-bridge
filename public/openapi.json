{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenCode Protocol Bridge API",
    "version": "1.0.0",
    "description": "Claude Messages、OpenAI Responses、Chat Completions 与 Google Gemini GenerateContent 兼容中转接口。"
  },
  "servers": [
    { "url": "/zen/v1", "description": "强制转发到 OpenCode Zen" },
    { "url": "/go/v1", "description": "强制转发到 OpenCode Go" },
    { "url": "/v1", "description": "兼容入口，按模型路由选择上游" }
  ],
  "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }, { "googleApiKeyAuth": [] }],
  "paths": {
    "/models": {
      "get": {
        "summary": "获取默认上游模型列表",
        "parameters": [{ "name": "provider", "in": "query", "schema": { "type": "string", "enum": ["zen", "go", "all"] } }],
        "responses": { "200": { "description": "模型列表", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}": {
      "get": {
        "summary": "获取单个模型信息",
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }, { "name": "provider", "in": "query", "description": "仅通用 /v1 入口使用；/zen/v1 与 /go/v1 始终由路径决定上游。", "schema": { "type": "string", "enum": ["zen", "go"] } }],
        "responses": { "200": { "description": "模型信息", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "模型不存在", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/messages": {
      "post": {
        "summary": "Claude Messages 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "messages": { "type": "array" } } } } } },
        "responses": { "200": { "description": "Claude Message 或 SSE 流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/responses": {
      "post": {
        "summary": "OpenAI Responses 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "input"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "input": {} } } } } },
        "responses": { "200": { "description": "OpenAI Response 或 SSE 流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/chat/completions": {
      "post": {
        "summary": "OpenAI Chat Completions 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "messages": { "type": "array" } } } } } },
        "responses": { "200": { "description": "Chat Completion 或 SSE 流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}:generateContent": {
      "post": {
        "summary": "Google Gemini GenerateContent 兼容接口",
        "servers": [{ "url": "/v1beta" }, { "url": "/v1" }, { "url": "/zen/v1beta" }, { "url": "/zen/v1" }, { "url": "/go/v1beta" }, { "url": "/go/v1" }],
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }],
        "requestBody": { "required": true, "description": "Google GenerateContentRequest；JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateContentRequest" } } } },
        "responses": { "200": { "description": "Google GenerateContentResponse", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}:streamGenerateContent": {
      "post": {
        "summary": "Google Gemini StreamGenerateContent SSE 兼容接口",
        "servers": [{ "url": "/v1beta" }, { "url": "/v1" }, { "url": "/zen/v1beta" }, { "url": "/zen/v1" }, { "url": "/go/v1beta" }, { "url": "/go/v1" }],
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }, { "name": "alt", "in": "query", "schema": { "type": "string", "enum": ["sse"] }, "description": "Google SDK 通常传入 alt=sse；该端点始终返回 SSE。" }],
        "requestBody": { "required": true, "description": "Google GenerateContentRequest；JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateContentRequest" } } } },
        "responses": { "200": { "description": "GenerateContentResponse SSE 数据帧（无 [DONE]）", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    }
  },
  "components": {
    "headers": {
      "LocalRequestId": { "description": "本项目为每个 HTTP 请求生成的 128 位十六进制追踪 ID；推理请求日志使用同一值。", "schema": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
      "KeyAttempts": { "description": "发生自动切换时返回，值为实际尝试的 Key 数量。推理请求仅对 401、403、429 切换；幂等模型发现还可对网络错误和 5xx 切换。", "schema": { "type": "integer", "minimum": 2 } },
      "RetryAfter": { "description": "建议等待秒数或 HTTP 日期，来自本地冷却策略或最终上游响应。", "schema": { "type": "string" } },
      "UpstreamRequestId": { "description": "最终上游响应的请求追踪 ID；本项目自己的请求 ID 仍位于 x-request-id。", "schema": { "type": "string", "maxLength": 256 } },
      "Allow": { "description": "该端点允许的 HTTP 方法。", "schema": { "type": "string", "enum": ["GET", "POST"] } }
    },
    "schemas": {
      "ModelId": { "type": "string", "minLength": 1, "maxLength": 256 },
      "GenerateContentRequest": { "type": "object", "required": ["contents"], "properties": { "contents": { "type": "array", "minItems": 1 }, "systemInstruction": { "type": "object" }, "generationConfig": { "type": "object" }, "tools": { "type": "array" }, "toolConfig": { "type": "object" } } }
    },
    "responses": {
      "InvalidRequest": { "description": "请求格式或跨协议参数不兼容", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "Unauthorized": { "description": "访问令牌无效", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "BodyTooLarge": { "description": "请求体超过 10 MiB", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "UnsupportedMediaType": { "description": "JSON 请求体的 Content-Type 或 Content-Encoding 不受支持", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "MethodNotAllowed": { "description": "HTTP 方法不受该端点支持", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Allow": { "$ref": "#/components/headers/Allow" } } },
      "RateLimited": { "description": "达到本地并发上限或最终上游仍然限流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } },
      "UpstreamError": { "description": "上游连接、响应或协议转换失败", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } },
      "UpstreamTimeout": { "description": "建立连接、等待响应头或读取响应体超时", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "NotConfigured": { "description": "对应 OpenCode 上游密钥尚未配置，或全部 Key 正在短时冷却", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" } } }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "管理面板生成或自定义的客户端令牌；自定义值为 6–256 位英文字母或数字。" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "与 Bearer 令牌相同。" },
      "googleApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-goog-api-key", "description": "Gemini SDK 风格认证；填写桥接客户端令牌，不是 Google 或 OpenCode 上游 Key。" }
    }
  }
}

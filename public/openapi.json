{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenCode Protocol Bridge API",
    "version": "1.0.0",
    "description": "Claude Messages、OpenAI Responses、Chat Completions 与 Google Gemini GenerateContent 兼容中转接口。"
  },
  "servers": [
    { "url": "/zen/v1", "description": "强制转发到 OpenCode Zen" },
    { "url": "/go/v1", "description": "强制转发到 OpenCode Go" },
    { "url": "/v1", "description": "兼容入口，按模型路由选择上游" }
  ],
  "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }, { "googleApiKeyAuth": [] }],
  "paths": {
    "/models": {
      "get": {
        "summary": "获取默认上游模型列表",
        "parameters": [{ "name": "provider", "in": "query", "schema": { "type": "string", "enum": ["zen", "go", "all"] } }],
        "responses": { "200": { "description": "模型列表", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}": {
      "get": {
        "summary": "获取单个模型信息",
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }, { "name": "provider", "in": "query", "description": "仅通用 /v1 入口使用；/zen/v1 与 /go/v1 始终由路径决定上游。", "schema": { "type": "string", "enum": ["zen", "go"] } }],
        "responses": { "200": { "description": "模型信息", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "模型不存在", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/messages": {
      "post": {
        "summary": "Claude Messages 兼容接口",
        "parameters": [{ "name": "beta", "in": "query", "description": "Anthropic Beta SDK 固定使用 beta=true；Claude 同协议路由会安全转发该标记，跨协议转换只使用已解析的正文与能力头。", "schema": { "type": "string", "enum": ["true"] } }],
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "max_tokens": { "type": "integer", "minimum": 1 }, "temperature": { "type": "number", "minimum": 0, "maximum": 1 }, "top_p": { "type": "number", "minimum": 0, "maximum": 1 }, "top_k": { "type": "integer", "minimum": 1 }, "speed": { "type": ["string", "null"], "enum": ["standard", "fast", null] }, "stop_sequences": { "type": "array", "items": { "type": "string" } }, "system": { "oneOf": [{ "type": "string" }, { "type": "array" }] }, "metadata": { "type": ["object", "null"], "properties": { "user_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 } }, "additionalProperties": false }, "messages": { "type": "array" }, "tools": { "type": "array" }, "tool_choice": { "type": "object", "properties": { "type": { "type": "string", "enum": ["auto", "any", "tool", "none"] }, "name": { "type": "string" }, "disable_parallel_tool_use": { "type": "boolean" } } }, "thinking": { "$ref": "#/components/schemas/ClaudeThinking" }, "context_management": { "$ref": "#/components/schemas/ClaudeContextManagement" }, "output_config": { "type": "object", "properties": { "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }, "format": { "type": "object" } } } } } } } },
        "responses": { "200": { "description": "Claude Message 或 SSE 流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-accel-buffering": { "$ref": "#/components/headers/SseBuffering" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" }, "x-opencode-tool-adaptations": { "$ref": "#/components/headers/ToolAdaptations" }, "x-opencode-input-degradations": { "$ref": "#/components/headers/InputDegradations" }, "x-opencode-reasoning-adaptations": { "$ref": "#/components/headers/ReasoningAdaptations" }, "x-opencode-context-adaptations": { "$ref": "#/components/headers/ContextAdaptations" }, "x-opencode-cache-adaptations": { "$ref": "#/components/headers/CacheAdaptations" }, "x-opencode-service-adaptations": { "$ref": "#/components/headers/ServiceAdaptations" }, "x-opencode-response-degradations": { "$ref": "#/components/headers/ResponseDegradations" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/messages/count_tokens": {
      "post": {
        "summary": "估算 Claude Message 输入 token",
        "parameters": [{ "name": "beta", "in": "query", "description": "兼容 Anthropic Beta SDK 的 countTokens 路径。", "schema": { "type": "string", "enum": ["true"] } }],
        "requestBody": { "required": true, "description": "Claude CountMessageTokensRequest；JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "messages": { "type": "array", "minItems": 1 }, "system": {}, "tools": { "type": "array" } } } } } },
        "responses": { "200": { "description": "本地保守估算结果", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-token-count": { "$ref": "#/components/headers/TokenCountMode" } }, "content": { "application/json": { "schema": { "type": "object", "required": ["input_tokens"], "properties": { "input_tokens": { "type": "integer", "minimum": 1 } } } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    },
    "/responses": {
      "post": {
        "summary": "OpenAI Responses 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB。stream_options 仅可与 stream:true 同时使用。同协议完整透传；跨到 Chat/Claude 时 previous_response_id、conversation、background:true、store:true、自动截断、服务端 prompt、max_tool_calls、context_management 和消息 phase 会明确返回 400。跨协议历史工具调用与结果必须携带合法的关联 ID、名称和 JSON 对象参数。 Codex 0.147+ client_metadata 同协议透传，跨协议校验后移除并通过 x-opencode-input-degradations 标记。", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "input"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "stream_options": { "type": "object", "properties": { "include_obfuscation": { "type": "boolean", "default": true } }, "additionalProperties": false }, "input": { "oneOf": [{ "type": "string" }, { "type": "array" }] }, "max_output_tokens": { "type": "integer", "minimum": 1 }, "temperature": { "type": "number", "minimum": 0, "maximum": 2 }, "top_p": { "type": "number", "minimum": 0, "maximum": 1 }, "tools": { "type": "array" }, "tool_choice": {}, "parallel_tool_calls": { "type": "boolean" }, "top_logprobs": { "type": "integer", "minimum": 0, "maximum": 20 }, "reasoning": { "$ref": "#/components/schemas/ResponsesReasoning" }, "store": { "type": "boolean" }, "background": { "type": "boolean" }, "previous_response_id": { "type": ["string", "null"] }, "conversation": {}, "truncation": { "type": ["string", "null"] }, "include": { "type": "array", "items": { "type": "string" } }, "max_tool_calls": { "type": ["integer", "null"] }, "context_management": { "type": "array" }, "prompt": {}, "service_tier": { "$ref": "#/components/schemas/OpenAIServiceTier" }, "safety_identifier": { "type": "string", "minLength": 1, "maxLength": 64 }, "user": { "type": "string", "minLength": 1 }, "moderation": { "type": "object" }, "metadata": { "$ref": "#/components/schemas/OpenAIMetadata" }, "client_metadata": { "type": "object", "maxProperties": 64, "propertyNames": { "minLength": 1, "maxLength": 128 }, "additionalProperties": { "type": "string", "maxLength": 1048576 } }, "text": { "type": "object", "properties": { "verbosity": { "$ref": "#/components/schemas/OpenAIVerbosity" }, "format": { "type": "object" } } } } } } } },
        "responses": { "200": { "description": "OpenAI Response 或 SSE 流；跨协议生成时回显可移植的请求配置，区分正常完成、输出截断和内容过滤，并为不完整输出项设置 incomplete 状态", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-accel-buffering": { "$ref": "#/components/headers/SseBuffering" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" }, "x-opencode-tool-degradations": { "$ref": "#/components/headers/ToolDegradations" }, "x-opencode-tool-adaptations": { "$ref": "#/components/headers/ToolAdaptations" }, "x-opencode-input-degradations": { "$ref": "#/components/headers/InputDegradations" }, "x-opencode-reasoning-adaptations": { "$ref": "#/components/headers/ReasoningAdaptations" }, "x-opencode-cache-adaptations": { "$ref": "#/components/headers/CacheAdaptations" }, "x-opencode-service-adaptations": { "$ref": "#/components/headers/ServiceAdaptations" }, "x-opencode-response-degradations": { "$ref": "#/components/headers/ResponseDegradations" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/responses/compact": {
      "post": {
        "summary": "压缩 OpenAI Responses 上下文",
        "description": "仅透传到协议配置为 responses 且实际实现该扩展的原生上游；不为 Chat、Claude 或 Gemini 伪造等价压缩。OpenCode 公开模型表未单独承诺此扩展，未实现时会返回规范化上游错误。返回的 compaction 输出项及其 encrypted_content 保持原样。",
        "requestBody": { "required": true, "description": "OpenAI Responses compact JSON 请求；仅支持非流式调用，请求体最大 10 MiB。", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "input"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "input": { "oneOf": [{ "type": "string" }, { "type": "array" }] }, "instructions": {}, "previous_response_id": { "type": ["string", "null"] } } } } } },
        "responses": { "200": { "description": "包含原生 compaction 输出项的 OpenAI Response", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/chat/completions": {
      "post": {
        "summary": "OpenAI Chat Completions 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB。stream_options 仅可与 stream:true 同时使用；include_usage:true 会生成独立 choices:[] 用量块，并使其它 choices chunk 带 usage:null。Responses 与 Chat 之间保留 OpenAI 通用服务控制字段；store:true、多候选、音频输出和无法表达的托管能力跨协议时明确返回 400。旧式 functions/function_call 会转成现代函数工具。跨协议历史 tool_calls/function_call 与 tool 结果必须携带合法的关联 ID、名称和 JSON 对象参数。", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "stream_options": { "type": "object", "properties": { "include_usage": { "type": "boolean" }, "include_obfuscation": { "type": "boolean", "default": true } }, "additionalProperties": false }, "messages": { "type": "array" }, "max_tokens": { "type": "integer", "minimum": 1 }, "max_completion_tokens": { "type": "integer", "minimum": 1 }, "temperature": { "type": "number", "minimum": 0, "maximum": 2 }, "top_p": { "type": "number", "minimum": 0, "maximum": 1 }, "stop": { "oneOf": [{ "type": "string" }, { "type": "array", "maxItems": 4, "items": { "type": "string" } }, { "type": "null" }] }, "seed": { "type": "integer" }, "presence_penalty": { "type": "number", "minimum": -2, "maximum": 2 }, "frequency_penalty": { "type": "number", "minimum": -2, "maximum": 2 }, "tools": { "type": "array" }, "tool_choice": {}, "parallel_tool_calls": { "type": "boolean" }, "logprobs": { "type": "boolean" }, "top_logprobs": { "type": "integer", "minimum": 0, "maximum": 20 }, "store": { "type": "boolean" }, "n": { "type": "integer", "minimum": 1 }, "modalities": { "type": "array", "items": { "type": "string" } }, "audio": { "type": "object" }, "prediction": {}, "logit_bias": { "type": "object" }, "web_search_options": { "type": "object" }, "functions": { "type": "array" }, "function_call": {}, "service_tier": { "$ref": "#/components/schemas/OpenAIServiceTier" }, "safety_identifier": { "type": "string", "minLength": 1, "maxLength": 64 }, "user": { "type": "string", "minLength": 1 }, "verbosity": { "$ref": "#/components/schemas/OpenAIVerbosity" }, "moderation": { "type": "object" }, "metadata": { "$ref": "#/components/schemas/OpenAIMetadata" } } } } } },
        "responses": { "200": { "description": "Chat Completion 或 SSE 流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-accel-buffering": { "$ref": "#/components/headers/SseBuffering" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" }, "x-opencode-input-degradations": { "$ref": "#/components/headers/InputDegradations" }, "x-opencode-reasoning-adaptations": { "$ref": "#/components/headers/ReasoningAdaptations" }, "x-opencode-cache-adaptations": { "$ref": "#/components/headers/CacheAdaptations" }, "x-opencode-service-adaptations": { "$ref": "#/components/headers/ServiceAdaptations" }, "x-opencode-response-degradations": { "$ref": "#/components/headers/ResponseDegradations" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}:generateContent": {
      "post": {
        "summary": "Google Gemini GenerateContent 兼容接口",
        "servers": [{ "url": "/v1beta" }, { "url": "/v1" }, { "url": "/zen/v1beta" }, { "url": "/zen/v1" }, { "url": "/go/v1beta" }, { "url": "/go/v1" }],
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }],
        "requestBody": { "required": true, "description": "Google GenerateContentRequest；JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateContentRequest" } } } },
        "responses": { "200": { "description": "Google GenerateContentResponse；Zen 原生 Gemini 模型同协议透传，其它模型按官方 Claude / Responses / Chat 协议互转。Google Search 与 Responses web_search 可双向映射，搜索词和 URL 引用以 groundingMetadata 返回。", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" }, "x-opencode-tool-adaptations": { "$ref": "#/components/headers/ToolAdaptations" }, "x-opencode-input-degradations": { "$ref": "#/components/headers/InputDegradations" }, "x-opencode-reasoning-adaptations": { "$ref": "#/components/headers/ReasoningAdaptations" }, "x-opencode-generation-adaptations": { "$ref": "#/components/headers/GenerationAdaptations" }, "x-opencode-response-degradations": { "$ref": "#/components/headers/ResponseDegradations" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    },
    "/models/{model}:streamGenerateContent": {
      "post": {
        "summary": "Google Gemini StreamGenerateContent SSE 兼容接口",
        "servers": [{ "url": "/v1beta" }, { "url": "/v1" }, { "url": "/zen/v1beta" }, { "url": "/zen/v1" }, { "url": "/go/v1beta" }, { "url": "/go/v1" }],
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }, { "name": "alt", "in": "query", "schema": { "type": "string", "enum": ["sse"] }, "description": "Google SDK 通常传入 alt=sse；该端点始终返回 SSE。" }],
        "requestBody": { "required": true, "description": "Google GenerateContentRequest；JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateContentRequest" } } } },
        "responses": { "200": { "description": "GenerateContentResponse SSE 数据帧（无 [DONE]）；Zen 原生 Gemini 流可同协议透传或转换到其它客户端协议，搜索词与 URL 引用在终止帧以 groundingMetadata 返回。", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-accel-buffering": { "$ref": "#/components/headers/SseBuffering" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" }, "x-opencode-tool-adaptations": { "$ref": "#/components/headers/ToolAdaptations" }, "x-opencode-input-degradations": { "$ref": "#/components/headers/InputDegradations" }, "x-opencode-reasoning-adaptations": { "$ref": "#/components/headers/ReasoningAdaptations" }, "x-opencode-generation-adaptations": { "$ref": "#/components/headers/GenerationAdaptations" }, "x-opencode-response-degradations": { "$ref": "#/components/headers/ResponseDegradations" } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "405": { "$ref": "#/components/responses/MethodNotAllowed" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedMediaType" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } }
      }
    }
  },
  "components": {
    "headers": {
      "LocalRequestId": { "description": "本项目为每个 HTTP 请求生成的 128 位十六进制追踪 ID；推理请求日志使用同一值。", "schema": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
      "SseBuffering": { "description": "仅流式成功响应返回固定值 no，请求 Nginx 类反向代理禁用响应缓冲。", "schema": { "type": "string", "enum": ["no"] } },
      "KeyAttempts": { "description": "发生自动切换时返回，值为实际尝试的 Key 数量。推理请求仅对 401、403、429 切换；幂等模型发现还可对网络错误和 5xx 切换。", "schema": { "type": "integer", "minimum": 2 } },
      "RetryAfter": { "description": "建议等待秒数或 HTTP 日期，来自最终上游响应或本地并发限制。", "schema": { "type": "string" } },
      "UpstreamRequestId": { "description": "最终上游响应的请求追踪 ID；本项目自己的请求 ID 仍位于 x-request-id。", "schema": { "type": "string", "maxLength": 256 } },
      "ToolDegradations": { "description": "仅在跨协议时无法向上游提供请求中的托管工具时返回；当前值 web_search 表示原始声明仍保留在客户端 Response 元数据中，但目标路由未执行托管搜索。Responses → Chat 在启用本地 Web Search 时会改为可执行 MCP 适配，不返回此降级。", "schema": { "type": "string", "enum": ["web_search"] } },
      "InputDegradations": { "description": "跨协议时，客户端自行带入且并非本桥接封装的供应商私有状态或客户端遥测无法由目标上游消费；responses_client_metadata 表示已校验并移除 Codex/Responses 的客户端遥测（不会注入模型上下文），responses_item_metadata 表示 Responses 历史项的 id/status 已校验但目标协议无等价元数据字段，responses_item_phase 表示 Codex 历史消息的 commentary/final_answer 展示通道已校验且正文与顺序保留，responses_empty_assistant_placeholder 表示已移除不含文本、工具、附件、注解或缓存语义的 Codex assistant 历史占位，responses_agent_message_to_user 表示 Codex 多代理明文消息已保留参与者信息并按用户轮次边界转换，encrypted_reasoning 表示 Responses 加密推理状态被忽略，responses_compaction_state 表示原生 Responses compaction/context_compaction 状态无法交给非 Responses 上游执行，gemini_thought_signature 表示 Gemini thoughtSignature 已识别并校验但未发送给非 Gemini 上游，claude_thinking_signature 与 claude_redacted_thinking 表示 Claude 模型绑定的签名或加密思考块已校验并移除，claude_compaction_encrypted_content 表示压缩摘要正文已保留但 Claude 专属加密压缩元数据无法发给非 Claude 上游，chat_reasoning_state 表示 Chat 历史中的外部签名或加密 reasoning_details 状态被忽略（可读 text/summary 仍会转换）。桥接生成且通过协议/状态种类/原始块结构校验的工具循环状态会通过目标协议的不透明字段或按工具身份隔离的短期缓存还原，不产生这些降级标记。多个值以逗号分隔。", "schema": { "type": "string", "pattern": "^(responses_client_metadata|responses_item_metadata|responses_item_phase|responses_empty_assistant_placeholder|responses_agent_message_to_user|encrypted_reasoning|responses_compaction_state|gemini_thought_signature|claude_thinking_signature|claude_redacted_thinking|claude_compaction_encrypted_content|chat_reasoning_state)(,(responses_client_metadata|responses_item_metadata|responses_item_phase|responses_empty_assistant_placeholder|responses_agent_message_to_user|encrypted_reasoning|responses_compaction_state|gemini_thought_signature|claude_thinking_signature|claude_redacted_thinking|claude_compaction_encrypted_content|chat_reasoning_state))*$" } },
      "ToolAdaptations": { "description": "跨协议发送工具时执行 Responses Lite 工具前缀提升、包装、本地或双向托管搜索映射、函数名别名、返回 Schema 描述降级、工具子集过滤、加载、展开、隐藏、工具失败状态正文标记、禁用托管程序运行时或最佳努力字段转换时返回；多个值以逗号分隔。", "schema": { "type": "string", "pattern": "^(additional_tools_to_top_level|custom|client_tool_search|hosted_tool_search|allowed_tools_filtered|gemini_google_search_to_web_search|responses_web_search_to_gemini_google_search|responses_web_search_to_mcp|responses_web_search_image_results_dropped|responses_web_search_image_settings_dropped|responses_web_search_token_budget_bounded|responses_web_search_history_compacted|claude_web_search_to_mcp|gemini_function_names_aliased|gemini_allowed_functions_filtered|gemini_validated_best_effort|gemini_response_schema_to_description|gemini_stream_function_args_reencoded|programmatic_tool_calling_disabled|output_schema_to_description|deferred_tools_loaded|deferred_tools_hidden|input_examples_to_description|allowed_callers_direct_only|eager_input_streaming_best_effort|claude_tool_error_to_content)(,(additional_tools_to_top_level|custom|client_tool_search|hosted_tool_search|allowed_tools_filtered|gemini_google_search_to_web_search|responses_web_search_to_gemini_google_search|responses_web_search_to_mcp|responses_web_search_image_results_dropped|responses_web_search_image_settings_dropped|responses_web_search_token_budget_bounded|responses_web_search_history_compacted|claude_web_search_to_mcp|gemini_function_names_aliased|gemini_allowed_functions_filtered|gemini_validated_best_effort|gemini_response_schema_to_description|gemini_stream_function_args_reencoded|programmatic_tool_calling_disabled|output_schema_to_description|deferred_tools_loaded|deferred_tools_hidden|input_examples_to_description|allowed_callers_direct_only|eager_input_streaming_best_effort|claude_tool_error_to_content))*$" } },
      "ReasoningAdaptations": { "description": "推理控制或历史推理内容不能由目标协议精确表达、已执行显式近似或最佳努力映射时返回；Responses Lite 的 all_turns 可在完整历史重放时降级承接，Codex sequential_cutoff 摘要交付会按目标流事件顺序最佳努力承接；Gemini 目标可接收 summary/thought 与 high effort，但不会把其它供应商的私有签名伪装成 Google thoughtSignature。多个值以逗号分隔。", "schema": { "type": "string", "pattern": "^(reasoning_context_all_turns_history_replay|reasoning_summary_sequential_cutoff_best_effort|thinking_level_minimal_to_low|thinking_budget_to_effort|thinking_budget_to_adaptive|reasoning_summary_to_claude_display|thinking_display_to_reasoning_summary|reasoning_summary_best_effort_chat|reasoning_summary_to_gemini_thoughts|reasoning_effort_minimal_to_low|reasoning_effort_unavailable_chat|reasoning_effort_to_gemini_high|claude_effort_to_reasoning_effort|claude_effort_unavailable_with_disabled_thinking|reasoning_history_to_chat_reasoning_content|reasoning_history_to_assistant_text|reasoning_history_to_gemini_thought)(,(reasoning_context_all_turns_history_replay|reasoning_summary_sequential_cutoff_best_effort|thinking_level_minimal_to_low|thinking_budget_to_effort|thinking_budget_to_adaptive|reasoning_summary_to_claude_display|thinking_display_to_reasoning_summary|reasoning_summary_best_effort_chat|reasoning_summary_to_gemini_thoughts|reasoning_effort_minimal_to_low|reasoning_effort_unavailable_chat|reasoning_effort_to_gemini_high|claude_effort_to_reasoning_effort|claude_effort_unavailable_with_disabled_thinking|reasoning_history_to_chat_reasoning_content|reasoning_history_to_assistant_text|reasoning_history_to_gemini_thought))*$" } },
      "ContextAdaptations": { "description": "Claude context_management 在非 Claude 上游由桥接本地精确执行时返回。", "schema": { "type": "string", "enum": ["claude_keep_all_thinking_local"] } },
      "ServiceAdaptations": { "description": "Claude speed 与 OpenAI/OpenCode service_tier 的等价跨协议映射；只转换 standard/default 和 fast/fast，其他容量层不会伪装为速度。多个值以逗号分隔。", "schema": { "type": "string", "pattern": "^(claude_standard_speed_to_openai_default_tier|claude_fast_speed_to_openai_fast_tier|openai_default_tier_to_claude_standard_speed|openai_fast_tier_to_claude_fast_speed)(,(claude_standard_speed_to_openai_default_tier|claude_fast_speed_to_openai_fast_tier|openai_default_tier_to_claude_standard_speed|openai_fast_tier_to_claude_fast_speed))*$" } },
      "GenerationAdaptations": { "description": "来源协议的生成采样参数在目标协议没有等价字段、因而被明确移除时返回。gemini_top_k_dropped 表示 Gemini topK 无法发送到 Responses 或 Chat。", "schema": { "type": "string", "enum": ["gemini_top_k_dropped"] } },
      "CacheAdaptations": { "description": "Claude、Responses 与 GPT-5.6 Chat prompt caching 跨协议转换结果；覆盖 OpenCode Chat 消息、工具定义及历史工具调用包装层 cache_control，TTL 或缓存 key/retention 无法等价表达时会明确标记。", "schema": { "type": "string", "pattern": "^(claude_cache_to_responses|claude_cache_to_chat|claude_cache_ttl_to_30m|claude_cache_control_dropped|responses_cache_to_claude|responses_cache_to_chat|chat_cache_to_responses|chat_cache_to_claude|responses_cache_ttl_to_5m|responses_cache_key_dropped|responses_cache_retention_dropped|responses_cache_control_dropped)(,(claude_cache_to_responses|claude_cache_to_chat|claude_cache_ttl_to_30m|claude_cache_control_dropped|responses_cache_to_claude|responses_cache_to_chat|chat_cache_to_responses|chat_cache_to_claude|responses_cache_ttl_to_5m|responses_cache_key_dropped|responses_cache_retention_dropped|responses_cache_control_dropped))*$" } },
      "ResponseDegradations": { "description": "仅非流式跨协议成功响应在上游返回目标协议无法表达的供应商元数据时返回；responses_reasoning_context 表示 Responses 回传的实际持久推理上下文模式没有目标协议字段。流式请求因响应头已发送，会把同样的精确列表写入请求日志。Claude 缓存写入总量与 5m/1h 明细仍分别保留在日志。", "schema": { "type": "string", "pattern": "^(responses_reasoning_context|claude_container|claude_context_management|claude_diagnostics|claude_stop_details|claude_cache_creation_ttl|claude_fallback_credit|claude_inference_geo|claude_iterations|claude_server_tool_use|claude_usage_service_tier)(,(responses_reasoning_context|claude_container|claude_context_management|claude_diagnostics|claude_stop_details|claude_cache_creation_ttl|claude_fallback_credit|claude_inference_geo|claude_iterations|claude_server_tool_use|claude_usage_service_tier))*$" } },
      "TokenCountMode": { "description": "token 数量由桥接服务本地保守估算，不会调用或计费上游模型；排除尚未被 tool_reference 加载的 deferred tools 与旧轮 thinking，已加载定义会计入，图片使用高分辨率 visual-token 上限。", "schema": { "type": "string", "enum": ["estimated"] } },
      "Allow": { "description": "该端点允许的 HTTP 方法。", "schema": { "type": "string", "enum": ["GET", "POST"] } }
    },
    "schemas": {
      "ModelId": { "type": "string", "minLength": 1, "maxLength": 256 },
      "OpenAIServiceTier": { "type": ["string", "null"], "enum": ["auto", "default", "flex", "scale", "priority", "fast", null] },
      "OpenAIVerbosity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
      "OpenAIMetadata": { "type": ["object", "null"], "maxProperties": 16, "propertyNames": { "maxLength": 64 }, "additionalProperties": { "type": "string", "maxLength": 512 } },
      "ResponsesReasoning": { "type": "object", "additionalProperties": false, "properties": { "effort": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] }, "summary": { "type": "string", "enum": ["auto", "concise", "detailed"] }, "generate_summary": { "type": "string", "enum": ["auto", "concise", "detailed"], "deprecated": true }, "mode": { "type": "string", "enum": ["standard", "pro"] }, "context": { "type": "string", "enum": ["auto", "current_turn", "all_turns"] } } },
      "ClaudeThinking": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "type": "string", "enum": ["adaptive", "enabled", "disabled"] }, "budget_tokens": { "type": "integer", "minimum": 1024 }, "display": { "type": "string", "enum": ["summarized", "omitted"] } } },
      "ClaudeContextManagement": { "type": "object", "additionalProperties": false, "required": ["edits"], "properties": { "edits": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["type", "keep"], "properties": { "type": { "type": "string", "enum": ["clear_thinking_20251015"] }, "keep": { "oneOf": [{ "const": "all" }, { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "all" } } }] } } } } } },
      "GeminiToolConfig": { "type": "object", "additionalProperties": false, "properties": { "functionCallingConfig": { "type": "object", "additionalProperties": false, "properties": { "mode": { "type": "string", "enum": ["AUTO", "ANY", "NONE", "VALIDATED"] }, "allowedFunctionNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "streamFunctionCallArguments": { "type": "boolean", "description": "仅用于 streamGenerateContent；跨协议时将完整 JSON 参数首次形成后的标量叶节点重编码为 PartialArg，无法无损拆分的空嵌套容器回退为标准完整 args。" } } } } },
      "GenerateContentRequest": { "type": "object", "required": ["contents"], "additionalProperties": false, "description": "原生 Gemini 路由同协议透传完整请求；转换到 Claude、Responses 或 Chat 时，只接受可移植子集并对无法表达的字段返回 400。", "properties": { "contents": { "type": "array", "minItems": 1 }, "systemInstruction": { "type": "object" }, "generationConfig": { "type": "object", "additionalProperties": true, "properties": { "stopSequences": { "type": "array", "items": { "type": "string" } }, "responseMimeType": { "type": "string", "enum": ["text/plain", "application/json"] }, "responseSchema": { "type": "object" }, "_responseJsonSchema": { "type": "object" }, "responseJsonSchema": { "type": "object" }, "responseFormat": { "type": "object" }, "responseModalities": { "type": "array", "items": { "type": "string", "enum": ["TEXT"] }, "maxItems": 1 }, "candidateCount": { "type": "integer", "minimum": 1 }, "maxOutputTokens": { "type": "integer", "minimum": 1 }, "temperature": { "type": "number" }, "topP": { "type": "number" }, "topK": { "type": "integer", "minimum": 1 }, "seed": { "type": "integer" }, "presencePenalty": { "type": "number" }, "frequencyPenalty": { "type": "number" }, "responseLogprobs": { "type": "boolean" }, "logprobs": { "type": "integer", "minimum": 0, "maximum": 20 }, "thinkingConfig": { "type": "object", "additionalProperties": true, "properties": { "thinkingBudget": { "type": "integer", "minimum": -1 }, "thinkingLevel": { "type": "string", "enum": ["minimal", "low", "medium", "high"] }, "includeThoughts": { "type": "boolean" } } } } }, "tools": { "type": "array" }, "toolConfig": { "$ref": "#/components/schemas/GeminiToolConfig" }, "safetySettings": { "type": "array", "items": { "type": "object" } }, "cachedContent": { "type": "string", "minLength": 1 } } }
    },
    "responses": {
      "InvalidRequest": { "description": "请求格式或跨协议参数不兼容", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "Unauthorized": { "description": "访问令牌无效", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "BodyTooLarge": { "description": "请求体超过 10 MiB", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "UnsupportedMediaType": { "description": "JSON 请求体的 Content-Type 或 Content-Encoding 不受支持", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "MethodNotAllowed": { "description": "HTTP 方法不受该端点支持", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Allow": { "$ref": "#/components/headers/Allow" } } },
      "RateLimited": { "description": "达到本地并发上限或最终上游仍然限流", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" }, "x-opencode-key-attempts": { "$ref": "#/components/headers/KeyAttempts" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } },
      "UpstreamError": { "description": "上游连接、响应或协议转换失败", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "x-opencode-upstream-request-id": { "$ref": "#/components/headers/UpstreamRequestId" } } },
      "UpstreamTimeout": { "description": "建立连接、等待响应头、读取非流式响应体或等待 SSE 上游数据超时", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" } } },
      "NotConfigured": { "description": "对应 OpenCode 上游密钥尚未配置", "headers": { "x-request-id": { "$ref": "#/components/headers/LocalRequestId" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" } } }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "管理面板生成或自定义的客户端令牌；自定义值为 6–256 位英文字母或数字。" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "与 Bearer 令牌相同。" },
      "googleApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-goog-api-key", "description": "Gemini SDK 风格认证；填写桥接客户端令牌，不是 Google 或 OpenCode 上游 Key。" }
    }
  }
}

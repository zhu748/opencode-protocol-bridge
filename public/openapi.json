{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenCode Protocol Bridge API",
    "version": "1.0.0",
    "description": "Claude Messages、OpenAI Responses 与 Chat Completions 兼容中转接口。"
  },
  "servers": [
    { "url": "/zen/v1", "description": "强制转发到 OpenCode Zen" },
    { "url": "/go/v1", "description": "强制转发到 OpenCode Go" },
    { "url": "/v1", "description": "兼容入口，按模型路由选择上游" }
  ],
  "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
  "paths": {
    "/models": {
      "get": {
        "summary": "获取默认上游模型列表",
        "parameters": [{ "name": "provider", "in": "query", "schema": { "type": "string", "enum": ["zen", "go", "all"] } }],
        "responses": { "200": { "description": "模型列表" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" } }
      }
    },
    "/models/{model}": {
      "get": {
        "summary": "获取单个模型信息",
        "parameters": [{ "name": "model", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ModelId" } }],
        "responses": { "200": { "description": "模型信息" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "模型不存在" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" } }
      }
    },
    "/messages": {
      "post": {
        "summary": "Claude Messages 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "messages": { "type": "array" } } } } } },
        "responses": { "200": { "description": "Claude Message 或 SSE 流" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" } }
      }
    },
    "/responses": {
      "post": {
        "summary": "OpenAI Responses 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "input"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "input": {} } } } } },
        "responses": { "200": { "description": "OpenAI Response 或 SSE 流" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" } }
      }
    },
    "/chat/completions": {
      "post": {
        "summary": "OpenAI Chat Completions 兼容接口",
        "requestBody": { "required": true, "description": "JSON 请求体最大 10 MiB", "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"], "properties": { "model": { "$ref": "#/components/schemas/ModelId" }, "stream": { "type": "boolean" }, "messages": { "type": "array" } } } } } },
        "responses": { "200": { "description": "Chat Completion 或 SSE 流" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "413": { "$ref": "#/components/responses/BodyTooLarge" }, "429": { "$ref": "#/components/responses/RateLimited" }, "502": { "$ref": "#/components/responses/UpstreamError" }, "503": { "$ref": "#/components/responses/NotConfigured" } }
      }
    }
  },
  "components": {
    "schemas": {
      "ModelId": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "responses": {
      "InvalidRequest": { "description": "请求格式或跨协议参数不兼容" },
      "Unauthorized": { "description": "访问令牌无效" },
      "BodyTooLarge": { "description": "请求体超过 10 MiB" },
      "RateLimited": { "description": "达到全局或客户端并发上限" },
      "UpstreamError": { "description": "上游连接、响应或协议转换失败" },
      "NotConfigured": { "description": "对应 OpenCode 上游密钥尚未配置" }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key" }
    }
  }
}

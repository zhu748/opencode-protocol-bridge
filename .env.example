# 复制为 .env.local 后按需修改；start-local.ps1 会自动加载 .env.local。
# 这些变量只会影响当前启动的 Node 进程，不需要写进系统环境变量。

# 本机启动默认只监听本机。局域网访问可改成 0.0.0.0。
HOST=127.0.0.1
PORT=8787

# 可选：配置加密主密钥，建议使用至少 32 字节的随机值。丢失后无法解密已保存配置。
# 新写入配置使用带随机盐的 scrypt + AES-256-GCM；旧 enc:v1 配置仍可读取并会在下次保存时升级。
# CONFIG_ENCRYPTION_KEY=changeThisToARandomValue123

# 可选：覆盖运行数据文件位置。容器默认使用挂载到 /app/data 的内置路径。
# CONFIG_FILE=data/config.json
# LOG_FILE=data/request-logs.json
# STATS_FILE=data/request-stats.json

# 可选：首次引导时直接创建管理密码和客户端调用令牌。
# 如果已经存在 data/config.json，这两项不会覆盖面板里保存的配置。
# 密码和令牌要求 6-256 位，只能包含英文字母或数字。
# OPENCODE_BRIDGE_ADMIN_PASSWORD=abc123
# OPENCODE_BRIDGE_CLIENT_TOKEN=client123

# 公网、无持久化部署可要求必须由上述两个变量完成引导；仅在可信反向代理后启用转发头信任。
# OPENCODE_BRIDGE_REQUIRE_ENV_BOOTSTRAP=false
# OPENCODE_BRIDGE_TRUST_PROXY=false

# 可选：同时执行的管理端变更请求上限，范围 1-128。
# OPENCODE_BRIDGE_MAX_ADMIN_MUTATIONS=16

# 可选：管理面板同时拉取上游模型列表的请求上限，范围 1-32。
# OPENCODE_BRIDGE_MAX_ADMIN_MODEL_DISCOVERIES=4

# 可选：Node HTTP 服务同时接受的连接数上限，范围 1-10000。
# OPENCODE_BRIDGE_MAX_HTTP_CONNECTIONS=256

# 可选：已鉴权公开推理/token 估算请求在上传和解析期间可预留的正文总字节数。
# 全局默认 64 MiB，每客户端默认 20 MiB；两者范围均为 10 MiB-1 GiB，单个 10 MiB Codex 长上下文不会被默认值拒绝。
# OPENCODE_BRIDGE_MAX_INFLIGHT_REQUEST_BODY_BYTES=67108864
# OPENCODE_BRIDGE_MAX_CLIENT_INFLIGHT_REQUEST_BODY_BYTES=20971520

# 可选：流式推理、大 JSON、图片附件和静态文件等待慢客户端恢复读取的最长时间，范围 100-300000 毫秒。
# OPENCODE_BRIDGE_STREAM_WRITE_TIMEOUT_MS=30000

# 可选：无上游事件时发送 SSE 注释心跳的间隔，范围 1000-60000 毫秒；设为 0 禁用。
# OPENCODE_BRIDGE_SSE_HEARTBEAT_MS=15000

# 可选：请求统计持久化容量上限（字节），默认 67108864（64 MiB），范围 1048576-134217728。
# 达到上限时会批量淘汰最旧记录并在统计页显示累计数量。
# OPENCODE_BRIDGE_STATS_MAX_BYTES=67108864

# 推荐批量 Key 写法：JSON 数组、逗号或换行分隔都支持，最多 32 把。
# 也可以不写在这里，启动后到管理面板的“连接设置”里添加。
# OPENCODE_ZEN_KEYS=["your-zen-key-1","your-zen-key-2"]
# OPENCODE_GO_KEYS=["your-go-key-1","your-go-key-2"]

# 单 Key 兼容写法。
# OPENCODE_ZEN_KEY=your-zen-key
# OPENCODE_GO_KEY=your-go-key

# 可选：仅用于开发、测试或私有镜像的上游基址覆盖。
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# 默认代理，未给单把 Key 设置代理时会回退到这里。
# 支持 http://、https://、socks4://、socks4a://、socks5://、socks5h://。
# Clash/mihomo mixed-port 可写 mixed://127.0.0.1:7890，会按 HTTP 代理使用。
# 也可以直接填写 hy2://、tuic://、vless://、vmess://、trojan://、ss://、hysteria:// 分享链接；
# 服务端需要能运行 sing-box。未在 PATH 时设置 OPENCODE_BRIDGE_SING_BOX_PATH。
# OPENCODE_PROXY_URL=http://127.0.0.1:7890
# OPENCODE_ZEN_PROXY_URL=http://127.0.0.1:7890
# OPENCODE_GO_PROXY_URL=socks5h://127.0.0.1:1080

# 可选：sing-box 可执行文件路径，用于托管 hy2/TUIC/VLESS/VMess 等分享链接。
# OPENCODE_BRIDGE_SING_BOX_PATH=C:\Tools\sing-box\sing-box.exe
# 可选：同时缓存的托管隧道数，范围 1-64；忙碌隧道不会被容量淘汰。
# OPENCODE_BRIDGE_MAX_MANAGED_TUNNELS=16
# 可选：空闲托管隧道的自动回收时间（毫秒），范围 1000-86400000；设为 0 禁用。
# OPENCODE_BRIDGE_MANAGED_TUNNEL_IDLE_MS=900000
# 可选：npm run install:sing-box / Docker / Render 使用的 sing-box 版本。
# OPENCODE_BRIDGE_SING_BOX_VERSION=1.13.16
# 可选：Linux 发布包类型 glibc、musl 或 purego；通常无需指定。
# OPENCODE_BRIDGE_SING_BOX_FLAVOR=musl
# 使用自定义 OPENCODE_BRIDGE_SING_BOX_DOWNLOAD_URL 时必须同时提供发布包 SHA-256。
# OPENCODE_BRIDGE_SING_BOX_DOWNLOAD_URL=https://mirror.example.com/sing-box.tar.gz
# OPENCODE_BRIDGE_SING_BOX_SHA256=64位十六进制摘要

# 与 OPENCODE_ZEN_KEYS / OPENCODE_GO_KEYS 按位置对应的独立代理。
# 需要某个槽位直连时，用 JSON 数组里的空字符串占位。
# OPENCODE_ZEN_PROXY_URLS=["http://127.0.0.1:7890",""]
# OPENCODE_GO_PROXY_URLS=["socks5h://127.0.0.1:1080",""]

# 兼容入口 /v1 未命中模型规则时默认走哪个上游：zen 或 go。
OPENCODE_BRIDGE_DEFAULT_PROVIDER=zen

# 可选：保活地址和间隔（秒）。URL 为空表示不覆盖面板设置。
# OPENCODE_BRIDGE_KEEP_ALIVE_URL=http://127.0.0.1:8787/healthz
# OPENCODE_BRIDGE_KEEP_ALIVE_INTERVAL_SECONDS=60

# 可选：Claude → Chat 的本地 Web Search 提供方与自建 MCP 端点。
# OPENCODE_BRIDGE_WEB_SEARCH_PROVIDER=auto
# OPENCODE_BRIDGE_WEB_SEARCH_MCP_URL=https://mcp.exa.ai/mcp
# OPENCODE_BRIDGE_WEB_SEARCH_PARALLEL_MCP_URL=https://search.parallel.ai/mcp
# EXA_API_KEY=your-exa-key

# 本机回环地址默认把文本模型无法读取的图片暂存到本机，并将路径交给客户端 vision 技能。
# Render Web Service 默认改用受限的 *.onrender.com 短时 URL；其它远程监听保持关闭。
# OPENCODE_BRIDGE_IMAGE_HANDOFF=true
# Render Web Service 未显式配置公网基址时会校验并使用 RENDER_EXTERNAL_HOSTNAME；设置为 false 可关闭这项自动启用。
# OPENCODE_BRIDGE_IMAGE_HANDOFF_DIR=C:\Temp
# 可选：图片交接临时文件总容量（字节），默认 268435456（256 MiB），范围 1048576-10737418240；设为 0 不限制。
# OPENCODE_BRIDGE_IMAGE_HANDOFF_MAX_BYTES=268435456
# 可选：本地路径附件最后一次使用后的保留时间（毫秒），默认 86400000（24 小时），范围 60000-2592000000；设为 0 保留到进程退出。
# OPENCODE_BRIDGE_IMAGE_HANDOFF_LOCAL_RETENTION_MS=86400000
# 其它远程部署或 Render 自定义域名可填写客户端可访问的 HTTPS 公网基址；图片下载链接默认 15 分钟失效。
# OPENCODE_BRIDGE_IMAGE_HANDOFF_PUBLIC_URL=https://your-custom-domain.example.com
